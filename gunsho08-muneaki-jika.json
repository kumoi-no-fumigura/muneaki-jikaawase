  {
   "seq": "2",
   "text": "河かせにゐてこす浪の玉島やえたにもぬける靑柳の露",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "をしなへてとくる氷の初花やかすみのさきの春をみす覽",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "松にふく風のしらへも春なからきゝしそむかし高砂の山",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かすかのやかきりしられぬ春の色をねにあらはして鶯そなく",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "峯の雪消ていくかの空ならむ松も檜原も杉もいろ〓〓",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "雪きえてかすむはかりや三輪の山春をゝしへしゝるし成らん",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春はなをはふきあまたに咲花の雲こそかゝれかつらきの山",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "はふき多き中にいつれを春の色にかけて葛の契をくらむ",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "おもふにも神やはうけし手向山ぬさとちりゆくはなの心は",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いせの海のちひろは沖のかすみにてみるめかひある春の濵風",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "咲もあへすうたて跡なく散花をとりやふりぬる業に恨みまし",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "さゝ浪や國津神代のおもかけにかすみてのころ浦のはま松",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "三島江の芦のわかはの露の上にたれしめをきて月やとすらん",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "しのゝめの霞色こき軒はより鶯の音のらうたけになく",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "こく舟のつなてくるしき鹽かまも春にうらみぬ浦の明ほの",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "夢にたにあひみぬ花の春なからしけるやうつゝうつの山越",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "月もこゝ波もたゝこゝてらすころにほてる匂ひ空霞ゆく",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "暮るまて下たく煙むすほゝれはれぬあしやの春雨の空",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "うらわかみをのゝ淺茅生なひくめり春風よはし吹上の演",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ちらて花常盤の色は住の江にへにげる松をしる人にせよ",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "かちをたえゆらのみさきの春の日にかすみをしのく沖の舟人",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "紅にふり出て花は咲ころをいかてしのふのやまほとゝきす",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "しかすかにのとけき春もふくをとや山は嵐の松の下庵",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "春の色をそこにふかめてみな瀨河夕日にかすむ山のはの空",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "いかにせむたこの浦波たゝぬ日にこひしかるへきあすの春哉",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "みちとせになるてふ色をせき入てかほるなかれの花の盃",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "けふはまた春のわかれの名にさへやたちこゆる波の末の松山",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "おほ淀のまつとせしまの春もいまうらみてかへる浪の夕暮",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "菫草ゑかくもたへしのへの色にまとゐせし夜の露の曙",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "大非河水の綠も夏木立しけれはかけのふかきころかな",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "うつろはむ秋を心にこめなからしけるしのたのもりの下草",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "茂りそふ軒にはくらき竹の葉のよな〓〓月を忍ふころ哉",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "さゝ分るゐなのゝ月のやとりさへ見る程なくてあくるよは哉",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "神風やみもすそ河のゆふすゝみ松ももゝ枝の影ひたすなり",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "夢やよそにふす程なしと過つ覽すゝむ枕のみしか夜の月",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あやめ草時過る身のした根をはいかほの沼のいかて知られん",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "白妙にあさゐる雲もゆふかけて夏おもしろき天のかく山",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "おき出て眺むる空のしのゝめに螢は薄くとひきえてゆく",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "大江山雲吹風も峯こえて木陰すゝしきゆふ立の露",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "夏かりのなにはのあしをさす棹の音にもちかき秋をしる哉",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "我妹子かきてもとふやとかたまては叩く水鷄に白む宿哉",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "まこも草ゆふ手をたゆみ夏の日のめくるやおそきみつの里人",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "沖つ風吹夕暮はまつらかたなつなきやまの名にしおふらん",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "松風に月ふけゆけは羅綺の上にかさなる霜の袂すゝしも",
   "kana": "",
   "speaker": "",
   "page": 578,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "秋といへはやかて哀もこもり江のはつせのひはら色は替らて",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "秋のくる〓とやわひしきたつた姫たゝなをさりの色はそめしと",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "花の色や露のしからみせきもあへす軈て移ふまのゝ萩原",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "いつはあれと須磨のしほ燒なれをしそ哀と思ふ秋のうら浪",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "さをしかの涙にまかふしら露も色にそめゆく宮城野の原",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "すかる鳴まかきも淋しのへ近くあれたる里の木々の下風",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "水くきの岡の木葉の秋風をいつとかまたむ膓の玉つさ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "風わたるふもとの尾花みねの松秋はをくらの山そかなしき",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "朧けの春の色をはなにかせむみなから花のむさしのゝ原",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "河風によそのきぬたの音なからねぬよしらるゝうちの山かけ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "染そめすぬるゝを色の槇の葉にはれぬときはのもりの秋霧",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "いてふれの櫓をゝす浪ににたる哉空とふ雁のむれて鳴聲",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "神垣やみむろの山のくすかつら靡くを見れは露のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "高圓の野への秋風ふくとに萩の下葉の夜寒をそしる",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "操返し過こしかたも後の世もつきせぬ露のゆふ暮の袖",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いこま山梢こり行今よりや時雨るゝ秋もよそにみゆらん",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "秋ふかきいくたの池のいくたひか空もしくれの森の下陰",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "稻妻は雲に光りて田面にはひたひく聲のかすかなる空",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "〓みかた關路の秋もやゝふけぬ山もとさむきいさり火の影",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "むらさきの一もとあらの萩ちれはなへてうつろふ武藏のゝ原",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "夜をのこす霧のうちなる月影にかはりて高く日の登る空",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "なかめしとさしもいふきの外山より暮れはおしき秋の色哉",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "慰めて月たにすまぬ秋ならは誰かはとはむさらしなのさと",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "かれ〓〓の千種の中に一本の類ひなき色やりうたんの花",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "月かけもいく有明にめくりきてけふしら河のせきの秋風",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "打よする浪さく色のひとつにてかるゝ野しまの秋のはつ霜",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "なくよりもみゝにたゝりて庭近くよる〓〓虫の冷然の聲",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "うら風にあかしのとなみ霧はれてたくもの煙哀にそたつ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "歸こむ我世もしらすあふくまやうきとし浪の秋のわかれち",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "亂あひて聞も色そふ袖なれやかさすも道のちらす匂ひに",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "見るまゝに山分衣たちかへて冬やきぬらむきよたきのなみ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "をしほ山ふたはの松もとしふりぬいくよなれてか時雨降らん",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "眺むれは峯さたかにも匂ふ日の曇る程なくしくれ行かけ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "今朝みれはゆきあひの霜の夜や寒き猶神さふる岸の姫まつ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "降雪のけふは昨ふの道かへてあとなきかたのみかりならまし",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "木がらしにとくは生田の杜の露なれこし秋をしのふ袖哉",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "旅にしてぬるゝ田簑の宿ながらからすはきかし夜半の時雨を",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "都には時雨ふるらし風の音もけさはあらちのみねのしら雲",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "友鶴のもろこゑになく庭の松よるの嵐に霜はさえつゝ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "時しらぬ山とし高くふる雪に松もはかへぬうきしまかはら",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "もみちせしあたちのまゆみちりしより夕日を寒み霰ふるなり",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "程もなく年はきはまるしはす哉らうを盡して過る月日の",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "よこ雲もたえ〓〓峯に立わかれあくるいなはのやまの白雪",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "いつの間に暮ゆく年の鏡山五十地にかゝるときんうつして",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "ひゝきあふ瀧の音してりうもんの松風とをくくもる雪哉",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "あはれともいはて年ふる里の名の伏見の夢にたれをまつらん",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "おもふかたありてやなひく鹽けふりはては霞のうら風そふく",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "思ひあれはもえつゝとはにふしのれのかゝる煙をたゝぬ苦しき",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "いかにして岩瀨に染めむ初時雨もりての色はさもあらはあれ",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "橘のした吹風やつくは山かりねのゆめのよはのうつり香",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "つれなきに悔しと思ひ果もせてやますや人を又慕はまし",
   "kana": "",
   "speaker": "",
   "page": 579,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "身をつくしくちぬしるしを思ふにもかけてそつらき袖の浦波",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "わかおもひ益田の池におふといふねぬなはたちて逢夜なき哉",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "身よいかに君くやとのみ待しよのけふも空しき妬さうれたさ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "人しれすふけ行夜半による波の高しの濵の松そかなしき",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "いまそしるあはてのもりの秋風よ木葉ふりしく契なりとは",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "あはて身はきゆとも人の必とせめては後の世をし契らは",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "思い沈む淵はありともしかすかの渡りし瀨をは忘れやはする",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "かけて思ふ演名の橋に滿鹽のなといやましに遠さかるらん",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "はかなくもまけてそ慕ふ中絕て悲しかるへき契と思ふに",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "さよふけぬなれも磯間の浦千鳥つまとふかたに鳴て行らむ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "つゆ雫やまの山もりもる山のやます心のしたにそめつゝ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "夜も更ぬきけは河風干鳥なく問へき人はすますなる身に",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "なる神の轟くよりもかなしきは親さへさけ!さのゝ舟橋",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "いるさまにあやめも分すかつ見るも安積の沼のえに社有けれ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "またさらんえにしもあならしらてけ〓〓〓〓〓そ身を返しけん",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "しるやいかにけたぬ思ひも陸奥のをたえの橋にかよふ物とは",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "空〓ををこらす神をも佛をもさしてをちかへしかも賴まん",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "三熊野の浦にかさなる濵ゆふのいふにもあまる袖をみせはや",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "たかかたになるみのうらのはまひさきひさしや〔本ノマヽ〕",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "夕暮と深く契るもひとかたにさため難さよ君はつれなし",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "二見かた磯なにましるうつせみの身につまゝれて哀とそみる",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "つゐにさてあはてくちぬる名取河ためしもしらぬ袖の埋木",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "文をたにたゝに返してみもいれす先は思ふにけしからぬ哉",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "よしの河千世にひとたひすむあれと渡時なき御代を知かな",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "あま衣世にしほたれし鈴鹿河すゝめむ浪のよるへしらせよ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "世のうきに忍ふにたえぬ遁れきて隱れん岩のはさまたにあれ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "降雪も半に消て時しるやけふみな月の不二のしは山",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "來るといへと秋も南にかへるやま春とて鴈の行もとまらす",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "笛竹の調へは代々にたえすてふ風も其音を知かゝしこき",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "今みるも下てる神やわたしけむ松に入日のあまのはし立",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "飛鳥かせ吹にもあらていたつらに七瀨すきたる跡をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "哀にも過行世かな河水もかはれはふちの瀨になかれつゝ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "時雨ゆく鳥羽山松はつれなくて木すへ色つく深草の里",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "あけぬまもをのれさきたち辰の市やかへる夕も人の世の中",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "旅はたゝつゆしも寒き野山をも家ちとたのむ契かなしも",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "袖寒み友よる千鳥こゑすなり小夜も更井の浦のしほかせ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "山姫や染し木の葉をこきませてさらしもあへぬ布引の瀧",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "玉きはる極めもしらすふへき世を必遠くしめむとや思ふ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "むかしたにしるしはかりの橋はしらあとも長柄の芦のむら立",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "かりねしてかへす衣はうすくともおもふゆめかせたま河の里",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "行年の巡り巡るやをのつから身に積りきて昔といふらん",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "さくらあさのおふの恨を人間はゝ世にまつ〓とのなしと答へよ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "かひかねはまた朝霧のはれのまになか〓〓あくる佐夜の中山",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "臂をまけて樂む方に利なりせは貧しき道も苦しからしな",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "おもひやる昔もさらにかなしきは秋のさかのゝ夜はの松風",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "暮ぬともきゝてわたらむすみた河かたりも出し都鳥かも",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "うる〓ともなくて年ふるしかまかち心の色は道にそむれと",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "音をそなく翅みしかき老の鶴のたつかた知らぬ若の浦ちに",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "しるや君神の定めしま〓人かみしもやすし干代も絕しな",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "立かへり代に逢坂のさねかつらくるしとのみはなに思ひけむ",
   "kana": "",
   "speaker": "",
   "page": 580,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
